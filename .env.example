# === Wajib ===
# Token bot dari @BotFather
BOT_TOKEN=isi_token_bot_di_sini
# Kunci enkripsi private key wallet. Generate dengan: openssl rand -hex 32
WALLET_ENCRYPTION_KEY=isi_kunci_enkripsi_di_sini
DATABASE_URL="file:./dev.db"

# === Opsional (default dipakai kalo kosong) ===
# RPC Solana (mainnet / devnet / custom)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# ID Telegram admin (angka) atau username (@nama) untuk tombol Bantuan
# Kosongkan untuk menyembunyikan tombol Chat Admin.
ADMIN_ID=

# === Scanner token baru (PumpPortal) ===
# Matikan scanner kalo mau bot wallet saja
SCANNER_ENABLED=true
# Jalanin scanner otomatis saat bot boot? false = tunggu klik "Start Scan"
SCANNER_AUTOSTART=false
# API key PumpPortal (pumpportal.fun) — KOSONGKAN = mode gratis.
# Wajib isi buat fitur akumulasi beli dev (0.01 SOL per 10.000 event).
PUMPPORTAL_API_KEY=
# Filter scanner (min dev buy, window, min market cap, jeda) diatur per user
# lewat menu ⚙️ Pengaturan. Nilai default ada di kode.

# === Copy-trade / Scan Wallet ===
# Butuh salah satu: PUMPPORTAL_API_KEY (atas) ATAU HELIUS_API_KEY (bawah).
# Tanpa dua-duanya, bot fallback ke RPC polling publik (lebih lambat).
# Sumber data: auto | pumpportal | helius | rpc
COPY_TRADE_PROVIDER=auto
# Interval polling RPC publik kalau provider=rpc (ms)
COPY_TRADE_RPC_POLL_MS=3000
# Helius (opsional) — fallback real-time tanpa PumpPortal API key
HELIUS_API_KEY=
# Opsional override endpoint (kosong = otomatis dari HELIUS_API_KEY)
# HELIUS_RPC_URL=
# HELIUS_WSS_URL=
# Aktif/nonaktifin fitur
COPY_TRADE_ENABLED=true
# true = SIMULASI (tidak kirim transaksi on-chain). Ubah ke false setelah yakin.
COPY_TRADE_DRY_RUN=true
# Nominal beli, TP, SL, maks posisi, umur posisi, slippage, dan priority fee
# diatur per user lewat menu ⚙️ Pengaturan.
# Pool: auto | pump | pump-amm | raydium | ...
COPY_TRADE_POOL=auto
# Interval cek harga buat auto TP (detik)
COPY_TRADE_POLL_SECONDS=10
